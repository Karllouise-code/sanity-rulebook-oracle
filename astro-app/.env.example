# --- Required ---
# Knowledge Base mode MCP endpoint created in the Sanity Context app.
# Starts with https://api.sanity.io/v1/context/organizations/<ORG_ID>/mcp/...
SANITY_CONTEXT_MCP_URL=
# Organization API token with "Context Viewer" permission.
SANITY_ORGANIZATION_TOKEN=

# --- Optional: LLM-composed answers ---
# If unset, answers are composed deterministically from retrieved entries.
# Gemini (free tier available) takes precedence when set.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model name. Default: gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
# OpenAI is used when the Gemini key is absent.
OPENAI_API_KEY=
# Optional model name. Default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# --- Optional: offline UI demo ---
# Set to 1 to answer from built-in demo entries instead of the live endpoint.
# Keep unset for the real Knowledge Base agent loop.
RULEBOOK_MOCK=